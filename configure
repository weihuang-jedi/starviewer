#!/bin/sh

#Configue file for NV.

 os=${OS=`uname -s`}

 case $os in
    Darwin)
	cp common.pri.macxos common.pri;
	cp nv.pro.macxos nv.pro;;
    Linux)
	cp common.pri.linux common.pri;
	cp nv.pro.linux nv.pro;;
    *):
	echo "Please copy: common.pri.macxos or common.pri.linux to common.pri";
	echo "   and copy: nv.pro.macxos or nv.pro.linux to nv.pro";
	echo "Then edit files: <common.pri> and <nv.pro> for your machine.";
	exit -1;;
 esac

