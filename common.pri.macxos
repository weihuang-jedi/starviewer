#Includes common configuration for all subdirectory .pro files.

 DESTDIR = /usr/local/lib/nv
#DESTDIR = /Users/weihuang/src/nv/lib
 message(The project will be installed in $$DESTDIR)

#sudo vi  /opt/local/etc/macports/macports.conf
#https://developer.apple.com/library/mac/documentation/DeveloperTools/Conceptual/DynamicLibraries/100-Articles/UsingDynamicLibraries.html

 TEMPLATE = lib app

#CONFIG	  += staticlib
 CONFIG	  += ordered

 WARNINGS += -Wall

#QMAKE_LINK = g++
#QMAKE_CXX = g++
 QMAKE_LINK = clang++
 QMAKE_CXX = clang++
 QMAKE_CXXFLAGS = -g -DUSENCL
#QMAKE_CXXFLAGS = -omp -g
#QMAKE_CC = gcc
 QMAKE_CC = clang
 QMAKE_CFLAGS = -g -DUSENCL
#QMAKE_CFLAGS = -omp -g
 QMAKE_LFLAGS = -g

#List of needed incs:

 INCLUDEPATH += .
#INCLUDEPATH += /Users/weihuang/anaconda2/include
 INCLUDEPATH += /usr/include
 INCLUDEPATH += /usr/local/include
 INCLUDEPATH += /usr/local/homebrew/include
 INCLUDEPATH += /usr/X11/include
 INCLUDEPATH += /usr/X11/include/freetype2
 INCLUDEPATH +=	/Users/weihuang/lib/NCLDEV/include
#INCLUDEPATH +=	/Users/weihuang/lib/radx/20140113/include

#List of needed libs:

#LIBS += -L$(DESTDIR) \
#        -L/Users/weihuang/lib/NCLDEV/lib
#	 -L/usr/lib \
#	 -L/opt/local/lib/gcc6 \
#	 -L/opt/local/lib/gcc6/gcc/x86_64-apple-darwin15/6.0.0 \
#	 -L/opt/local/lib \
#	 -lhdfeos \
#	 -lhdfeos5 -lGctp \
#	 -L/Users/weihuang/anaconda2/lib \

 LIBS += \
	 -L/usr/local/lib \
         -L/usr/X11/lib \
	 -L$(DESTDIR) \
	 -L/Users/weihuang/lib/NCLDEV/lib \
	 -L/usr/lib \
 	 -L/usr/local/homebrew/lib \
 	 -L/usr/local/homebrew/lib/gcc/6/gcc/x86_64-apple-darwin16.0.0/6.2.0 \
	 -lnetcdf -lcurl \
	 -lhdf5_hl -lhdf5 \
	 -lz \
	 -lsz \
	 -lhdfeos \
	 -lhe5_hdfeos -lGctp \
	 -lmfhdf -ldf -ljpeg \
	 -lsphere3.1_dp -lfftpack5_dp -llapack_ncl -lblas_ncl \
	 -lnfp -lnfpfort -lncarg_gks -lncarg_c -lncarg -lhlu -lncl \
	 -lpixman-1 -lcairo -lfontconfig \
	 -lgrib2c -lgdal -lproj \
	 -ludunits2 -lexpat \
	 -ljasper -lpng16 \
	 -lfreetype -lexpat \
	 -lpthread -lbz2 -lXrender \
	 -lXpm -lX11 -lXext -lgfortran -lm -ldl -lgcc_eh -lgcc \
	 -lquadmath -liconv -lc++ \
	 -Wl,-no_compact_unwind \
	 -Wl,-rpath,/usr/local/homebrew/lib \
	 -Wl,-rpath,/usr/lib

#	 -lngmath \

#Include OpenGL support
 QT += opengl

