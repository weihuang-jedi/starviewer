#!/bin/csh -f

 if($# > 0) then
    set flnm = $1
 else
    echo "Usage: $0 your-camse-0.25-degree-filename"
    exit -1
 endif

 set os = `uname -s`

 if("Linux" == ${os}) then
     vglrun nv -mappingfile $NV_DATA/camse_0.25degree_mapping.nc \
        -camse $flnm
 else
     nv -mappingfile $NV_DATA/camse_0.25degree_mapping.nc \
	-camse $flnm
 endif

