#!/bin/bash

 set -x

 cd /work2/noaa/epic/weihuang/nv/starviewer

 MODULE="hercules.gnu"

 if lsmod | grep -q "^$MODULE"; then
     echo "Module '$MODULE' is loaded."
 else
     module purge
     module use moduledir
     module load hercules.gnu 
 fi

#ldd /work2/noaa/epic/weihuang/nv/starviewer/build/main/starviewer | grep "not found"

#/work2/noaa/epic/weihuang/nv/starviewer/build/main/starviewer \
