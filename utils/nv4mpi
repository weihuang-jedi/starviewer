#!/bin/bash
set -x

export STARVIEWERHOME=/contrib/Wei.Huang/src/nv/starviewer

# 1. Create a clean, writable runtime dir
export RUNTIME_DIR=/contrib/Wei.Huang/tmp/runtime-dir
#mkdir -p $RUNTIME_DIR
#chmod 700 $RUNTIME_DIR

# 2. Run with --cleanenv to prevent host garbage from leaking in
singularity exec --nv --cleanenv \
    --bind $HOME/.Xauthority:/root/.Xauthority \
    --bind /contrib:/contrib \
    --env XAUTHORITY=/root/.Xauthority \
    --env DISPLAY=$DISPLAY \
    --env XDG_RUNTIME_DIR=$RUNTIME_DIR \
    --env QT_X11_NO_MITSHM=1 \
    /contrib/Wei.Huang/src/nv/starviewer.sandbox \
    /contrib/Wei.Huang/src/nv/starviewer/build/main/starviewer -mpi mpi

#   gdb --args \
#   /contrib/Wei.Huang/src/nv/starviewer/build/main/starviewer -mpi mpi
exit 0
