#Includes common configuration for all subdirectory .pro files.

#DESTDIR = $$(NV_HOME)/lib
 DESTDIR = /glade/u/apps/contrib/nv/lib
 message(The project will be installed in $$DESTDIR)

 TEMPLATE = lib app

 QMAKE_FC = gfortran
 QMAKE_CC = gcc
 QMAKE_CXX = g++

 QMAKE_CXXFLAGS = -DLINUX -DGL_GLEXT_PROTOTYPES -fPIC

#CONFIG   +=      staticlib
 CONFIG   += ordered

 WARNINGS += -Wall

#List of needed incs:

#-I/usr/include

 INCLUDEPATH += .
 INCLUDEPATH += /glade/p/work/huangwei/external_lib/include
 INCLUDEPATH += /glade/p/work/haley/dev/external/gnu/4.7.2/include
 INCLUDEPATH +=	/glade/p/work/huangwei/lib/ncl/6.2.1/include

#List of needed libs:

#LIBS += -L/Users/huangwei/ncl/GUINCL/lib \

 LIBS += -Wl,-rpath=$(DESTDIR) \
	 -L/usr/lib64 \
	 -L/glade/u/apps/opt/gnu/4.7.2/lib \
	 -L/glade/u/apps/contrib/nv/lib \
	 -L/glade/p/work/huangwei/external_lib/lib \
	 -L/glade/p/work/haley/dev/external/gnu/4.7.2/lib \
	 -L/glade/p/work/huangwei/lib/ncl/6.2.1/lib \
	 -lncl \
	 -lnfp -lnfpfort -lhlu \
	 -lncarg -lncarg_gks -lncarg_c \
	 -lngmath \
	 -lnetcdf -lcurl \
	 -lhe5_hdfeos -lGctp \
	 -lhdf5_hl -lhdf5 \
	 -lhdfeos \
	 -lmfhdf -ldf -ljpeg \
	 -lgdal -lproj \
	 -ludunits2 -lexpat \
	 -lgrib2c -ljasper -lpng \
	 -lcairo -lfontconfig -lpixman-1 \
	 -lfreetype -lexpat \
	 -lpng15 -lz \
	 -lpthread -lbz2 -lXrender \
	 -lsphere3.1_dp -lfftpack5_dp -llapack_ncl -lblas_ncl \
	 -lXpm -lX11 -lXext -lgfortran \
	 -lm -ldl

#	 -limf -lirc \

 LIBS += -lGLU

#Include OpenGL support
 QT += opengl

