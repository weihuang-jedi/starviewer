#!/bin/bash

 set -x

 # Create a temporary wildcard cookie file
 touch /home/weihuang/work/tmp/xauth_wildcard
 xauth nlist $DISPLAY | sed -e 's/^..../ffff/' | xauth -f /home/weihuang/work/tmp/xauth_wildcard nmerge -

 export STARVIEWERHOME=/home/weihuang/work/starviewer
 export CONTAINER_DIR=${STARVIEWERHOME}
 export CONTAINER_BINDINGS="-B /home"
 export RUNTIME_DIR=/home/weihuang/work/tmp/runtime-dir

 export CONTAINER_SIF=${CONTAINER_DIR}/starviewer.sif

 if [ ! -d $RUNTIME_DIR ]; then
     mkdir -p $RUNTIME_DIR
     chmod 700 $RUNTIME_DIR
 fi

# 1. On the host terminal (e01g01), allow the connection
xhost +local:$(whoami)
#   --bind ${HOME}/.Xauthority:${HOME}/.Xauthority \

apptainer exec --rocm \
    --cleanenv \
    --hostname $(hostname) \
    --bind /home/weihuang/work/tmp/xauth_wildcard:/tmp/xauth \
    -B /home \
    --env XAUTHORITY=/tmp/xauth \
    --env DISPLAY=$DISPLAY \
    --env XDG_RUNTIME_DIR=$RUNTIME_DIR \
    --env QT_X11_NO_MITSHM=1 \
    --env STARVIEWERHOME=${STARVIEWERHOME} \
    --env LIBGL_ALWAYS_INDIRECT=0 \
    "${CONTAINER_SIF}" \
    ${STARVIEWERHOME}/build/main/starviewer \
    -yaml yamlfiles/mpidemo-config.yaml

 exit 0
